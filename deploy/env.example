# ============================================================
# /etc/dsh-web/env — dsh web 服务的 systemd EnvironmentFile
# 安装后必须收紧权限（属主 root，服务用户可读）：
#   chown root:root /etc/dsh-web/env && chmod 600 /etc/dsh-web/env
# ============================================================

# 数据根目录：profiles / sessions / attachments / .credentials.yaml 都在这下面
# 必须与服务用户(DSH_HOME 属主)一致，且可写
DSH_HOME=/var/lib/dsh

# cookie HMAC 签名密钥（必填，>= 32 字符）
# 生成方式: openssl rand -hex 32
DSH_AUTH_SECRET=

# MySQL 密码（必填；用户/库由 deploy/install.sh 初始化，见 cordis.patch.prod.yml）
MYSQL_PASSWORD=

# 可选：关闭遥测（任何非空值即关闭）
# DSH_TELEMETRY_DISABLED=1
